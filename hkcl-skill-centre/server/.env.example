# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <db_username> with your MongoDB Atlas database username (Security > Database Access)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.e56pvog.mongodb.net/hkcl_skill_centre?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=hkcl_skill_centre_super_secret_jwt_key_2026

# Email Provider Configuration (Resend official SDK / API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM=HKCL Skill Centre <admissions@yourdomain.com>

# Manual UPI Payment Configuration
# Replace with the official HKCL Skill Centre UPI ID and Payee Name
CENTRE_UPI_ID=achariyainstitute@okaxis
CENTRE_PAYEE_NAME=HKCL Skill Centre (Achariya Educational Institution)

# Staff Payment Verification API Secret
# Secret key used in the 'x-staff-key' header by authorized staff/admin to verify or reject payments
STAFF_API_KEY=hkcl_staff_secret_key_2026

# Razorpay Credentials (Legacy / optional fallback)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Frontend Client URL (for CORS and verification links)
CLIENT_ORIGIN=http://localhost:5173
